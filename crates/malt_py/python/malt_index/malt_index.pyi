"""Type stubs for the `malt_index` extension module (see `crates/malt_py`)."""

from collections.abc import Sequence
from enum import Enum
from os import PathLike
from typing import Any, Final, Literal

_PathArg = str | PathLike[str]

class FilePathError(Exception): ...
class NameResolutionError(Exception): ...
class CyclicAliasError(Exception): ...

class Kind(str, Enum):
    FOLDER = "folder"
    NAMESPACE = "namespace"
    CLASS = "class"
    ENUMERATION = "enumeration"
    FUNCTION = "function"
    SCRIPT = "script"
    LIVE_SCRIPT = "live_script"
    PROPERTY = "property"

class ArgumentKind(str, Enum):
    POSITIONAL_ONLY = "positional-only"
    OPTIONAL = "optional"
    KEYWORD_ONLY = "keyword-only"
    VARARGIN = "varargin"

class AccessKind(str, Enum):
    PUBLIC = "public"
    PROTECTED = "protected"
    PRIVATE = "private"
    IMMUTABLE = "immutable"

class SectionKind(str, Enum):
    TEXT = "text"
    CODE = "code"

class ParserConfig:
    docstring_before_properties: bool
    docstring_before_arguments: bool
    docstring_before_enumerations: bool
    parse_live_scripts: bool
    def __init__(
        self,
        docstring_before_properties: bool = False,
        docstring_before_arguments: bool = False,
        docstring_before_enumerations: bool = False,
        parse_live_scripts: bool = False,
    ) -> None: ...

class Expr:
    @property
    def text(self) -> str: ...
    @property
    def lineno(self) -> int: ...
    @property
    def column(self) -> int: ...
    @property
    def endlineno(self) -> int: ...
    @property
    def endcolumn(self) -> int: ...
    def __str__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class LinesCollection:
    def lines(self, path: _PathArg) -> list[str]: ...
    def __getitem__(self, path: _PathArg) -> list[str]: ...
    def __contains__(self, path: _PathArg) -> bool: ...
    def keys(self) -> list[str]: ...

